# Neon Serverless PostgreSQL Database Connection URI
DATABASE_URL=postgresql://neondb_owner:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# Application Server Port
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin
FRONTEND_URL=http://localhost:5173

# Cryptographic Secrets
# Generate using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=your_super_secret_session_encryption_key_at_least_32_bytes
QR_HMAC_SECRET=your_super_secret_qr_hmac_signing_key_at_least_32_bytes

# QR Token Lifespan in seconds (Recommended: 60-120 seconds)
QR_TOKEN_TTL_SECONDS=90

# Session Lifespan in seconds (e.g., 24 hours = 86400)
SESSION_TTL_SECONDS=86400
